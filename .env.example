# Core
APP_ENV=development
DATABASE_URL=postgresql+psycopg://nomos:nomos@postgres:5432/nomos
REDIS_URL=redis://redis:6379/0

# Object storage
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET_PUBLIC=nomos-public
S3_BUCKET_PRIVATE=nomos-private

# Search
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Remote AI is optional and policy-gated
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI capability configuration (examples only; keep replaceable)
EMBEDDING_MODEL=
RERANKER_MODEL=
LOCAL_LLM_MODEL=
REMOTE_GENERAL_MODEL=
REMOTE_REASONING_MODEL=

# Privacy default for new organisations should be conservative
DEFAULT_REMOTE_AI_POLICY=PUBLIC_ONLY
